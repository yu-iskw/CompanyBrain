# Local mode is intentionally unavailable when NODE_ENV=production.
NODE_ENV=development
AUTH_MODE=local
LOCAL_USER_SUBJECT=local-developer
PORT=3000
BASE_URL=http://localhost:3000

# Fastest local Slack path. This token is held only in process memory.
SLACK_USER_TOKEN=

# Slack account-linking OAuth (preferred for realistic local testing).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/oauth/slack/callback

# GitHub delegated-user OAuth, or a direct user token for local MCP/API use.
GITHUB_USER_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/oauth/github/callback

# Durable PostgreSQL mode. Generate a key with: openssl rand -base64 32
DATABASE_URL=
CREDENTIAL_ENCRYPTION_KEY=

# Generic OIDC authorization-code + PKCE mode.
# AUTH_MODE=oidc
# OIDC_AUTHORIZATION_URL=https://identity.example.com/oauth2/authorize
# OIDC_TOKEN_URL=https://identity.example.com/oauth2/token
# OIDC_USERINFO_URL=https://identity.example.com/oauth2/userinfo
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid profile email
